# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-
# Main model used by the agent. Must support tool calling.
# Browse https://openrouter.ai/models — free models exist but are often
# rate-limited; the agent falls back to free models if this one is unavailable.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Smaller/cheaper model used for tests and evals
OPENROUTER_TEST_MODEL=google/gemini-2.5-flash-lite
